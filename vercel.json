{
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=8192 npm run build",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "redirects": [
    {
      "source": "/admin",
      "destination": "/404",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "www.top10lists.us"
        }
      ]
    },
    {
      "source": "/admin",
      "destination": "/404",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "top10lists.us"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "destination": "/404",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "www.top10lists.us"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "destination": "/404",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "top10lists.us"
        }
      ]
    },
    {
      "source": "/api-terms",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/p/:code",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/MASTER_KNOWLEDGE_DOCUMENT.md",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/MASTER_KNOWLEDGE_DOCUMENT",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/arizona",
      "destination": "/arizona/top10realestateagents",
      "permanent": true
    },
    {
      "source": "/california",
      "destination": "/california/top10realestateagents",
      "permanent": true
    },
    {
      "source": "/arizona/:city((?!agents|top10realestateagents)[a-z0-9-]+)",
      "destination": "/arizona/:city/top10realestateagents",
      "permanent": true
    },
    {
      "source": "/california/:city((?!agents|top10realestateagents)[a-z0-9-]+)",
      "destination": "/california/:city/top10realestateagents",
      "permanent": true
    },
    {
      "source": "/:state/:city/:zip(\\d{5})/:neighborhood/top10realestateagents",
      "destination": "/:state/:city/:neighborhood/top10realestateagents",
      "permanent": true
    },
    {
      "source": "/:state(arizona|california)/:city/best-real-estate-agents",
      "destination": "/:state/:city/top10realestateagents",
      "permanent": true
    },
    {
      "source": "/:state(arizona|california)/:city/best-real-estate-agents-:year(\\d{4})",
      "destination": "/:state/:city/top10realestateagents",
      "permanent": true
    },
    {
      "source": "/:state(arizona|california)/:city/best-realtors",
      "destination": "/:state/:city/top10realestateagents",
      "permanent": true
    },
    {
      "source": "/:state(arizona|california)/:city/top-real-estate-agents",
      "destination": "/:state/:city/top10realestateagents",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/mcp.json",
      "destination": "/mcp.json"
    },
    {
      "source": "/.well-known/jwks.json",
      "destination": "https://wiotrvoirdgzfacuuiem.supabase.co/functions/v1/signing-keys"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/coverage-stats",
      "destination": "https://wiotrvoirdgzfacuuiem.supabase.co/functions/v1/coverage-stats"
    },
    {
      "source": "/crawl-stats",
      "destination": "/api/serve-clean-html?fn=serve-bot-crawl-stats-html&path=%2Fcrawl-stats"
    },
    {
      "source": "/crawl-stats/",
      "destination": "/api/serve-clean-html?fn=serve-bot-crawl-stats-html&path=%2Fcrawl-stats"
    },
    {
      "source": "/artifact/:token",
      "destination": "https://wiotrvoirdgzfacuuiem.supabase.co/functions/v1/artifact-markdown?token=:token"
    },
    {
      "source": "/api/v1/agents/search",
      "destination": "https://wiotrvoirdgzfacuuiem.supabase.co/functions/v1/agents-search-api"
    },
    {
      "source": "/api/v1/agents/:id",
      "destination": "https://wiotrvoirdgzfacuuiem.supabase.co/functions/v1/agent-details?id=:id"
    },
    {
      "source": "/api/v1/markets",
      "destination": "https://wiotrvoirdgzfacuuiem.supabase.co/functions/v1/enrichment-api?action=markets"
    },
    {
      "source": "/arizona/top10realestateagents",
      "destination": "/api/serve-clean-html?fn=serve-bot-state-html&path=/arizona/top10realestateagents"
    },
    {
      "source": "/california/top10realestateagents",
      "destination": "/api/serve-clean-html?fn=serve-bot-state-html&path=/california/top10realestateagents"
    },
    {
      "source": "/for-ai",
      "destination": "/api/for-ai"
    },
    {
      "source": "/for-ai/",
      "destination": "/api/for-ai"
    },
    {
      "source": "/:state/:city/top10realestateagents",
      "destination": "/api/serve-clean-html?fn=serve-bot-list-html&path=/:state/:city/top10realestateagents"
    },
    {
      "source": "/:state/:city/:neighborhood/top10realestateagents",
      "destination": "/api/serve-clean-html?fn=serve-bot-list-html&path=/:state/:city/:neighborhood/top10realestateagents"
    },
    {
      "source": "/:state/agents/:slug",
      "destination": "/api/serve-clean-html?fn=serve-bot-agent-html&path=/:state/agents/:slug"
    },
    {
      "source": "/protocol-adopters",
      "destination": "/protocol-adopters/index.html"
    },
    {
      "source": "/protocol-adopters/",
      "destination": "/protocol-adopters/index.html"
    },
    {
      "source": "/email-signal-upsell",
      "destination": "/email-signal-upsell.html"
    },
    {
      "source": "/email-signal-upsell/",
      "destination": "/email-signal-upsell.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/pricing/",
      "destination": "/pricing.html"
    },
    {
      "source": "/transparency",
      "destination": "/api/serve-clean-html?fn=serve-bot-content-html&path=%2Ftransparency"
    },
    {
      "source": "/transparency/",
      "destination": "/api/serve-clean-html?fn=serve-bot-content-html&path=%2Ftransparency"
    },
    {
      "source": "/faq",
      "destination": "/api/serve-clean-html?fn=serve-bot-content-html&path=%2Ffaq"
    },
    {
      "source": "/faq/",
      "destination": "/api/serve-clean-html?fn=serve-bot-content-html&path=%2Ffaq"
    },
    {
      "source": "/methodology",
      "destination": "/api/serve-clean-html?fn=serve-bot-content-html&path=%2Fmethodology"
    },
    {
      "source": "/methodology/",
      "destination": "/api/serve-clean-html?fn=serve-bot-content-html&path=%2Fmethodology"
    },
    {
      "source": "/why-ai-trusts-us",
      "destination": "/api/serve-clean-html?fn=serve-bot-content-html&path=%2Fwhy-ai-trusts-us"
    },
    {
      "source": "/why-ai-trusts-us/",
      "destination": "/api/serve-clean-html?fn=serve-bot-content-html&path=%2Fwhy-ai-trusts-us"
    },
    {
      "source": "/api/t",
      "destination": "https://wiotrvoirdgzfacuuiem.supabase.co/functions/v1/email-track"
    },
    {
      "source": "/mcp",
      "destination": "https://wiotrvoirdgzfacuuiem.supabase.co/functions/v1/mcp-server"
    },
    {
      "source": "/((?!api|for-ai|methodology|ai-feed|llms|coverage\\.json|sitemap|mcp\\.json|mcp$|ai-content-index\\.json|robots\\.txt|\\.well-known|widget|crawl-stats).*)",
      "destination": "/_spa.html"
    },
    {
      "source": "/((?!widget/|api/|sitemap|crawl-stats).*)",
      "destination": "/_spa.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ],
      "has": [
        {
          "type": "host",
          "value": "staging\\.top10lists\\.us"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    },
    {
      "source": "/ai-feed/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap-:name.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/:state(arizona|california)/agents/:slug",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=30"
        }
      ]
    },
    {
      "source": "/:state(arizona|california)/:city/top10realestateagents/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=30"
        }
      ]
    },
    {
      "source": "/:state(arizona|california)/top10realestateagents",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=30"
        }
      ]
    },
    {
      "source": "/((?!api|assets|_next|favicon|badges|widget|sitemap|robots|llms|mcp|for-ai|methodology|ai-feed|coverage|ai-content-index|\\.well-known).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.top10lists.us/.well-known/mcp.json>; rel=\"mcp-server\"; type=\"application/json\""
        }
      ]
    }
  ]
}