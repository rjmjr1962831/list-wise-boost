{
  "buildCommand": "NODE_OPTIONS=--max-old-space-size=8192 npm run build",
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "functions": {
    "api/vercel-log-drain.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/admin",
      "destination": "/404",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "www.top10lists.us"
        }
      ]
    },
    {
      "source": "/admin",
      "destination": "/404",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "top10lists.us"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "destination": "/404",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "www.top10lists.us"
        }
      ]
    },
    {
      "source": "/crm",
