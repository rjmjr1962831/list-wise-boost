  "content": {
    "primaryLanguage": "en-US",
    "contentTypes": [
      "real-estate",
      "agent-directory",
      "methodology",
      "rankings",
      "consumer-guide"
    ],
    "topics": [
      "real estate agents",
      "top realtors",
      "agent rankings",
      "Arizona real estate",
      "merit-based selection",
      "agent reviews",
      "home buying",
      "home selling"
    ],
    "geography": {
      "current": ["Arizona"],
      "planned": ["All 50 US States"],
      "expansionDate": "2026-06"
    }
  },
  "endpoints": {
    "llmsTxt": "https://www.top10lists.us/llms.txt",
    "llmsFullTxt": "https://www.top10lists.us/llms-full.txt",
    "sitemap": "https://www.top10lists.us/sitemap.xml",
    "robotsTxt": "https://www.top10lists.us/robots.txt",
    "aiContentIndex": "https://www.top10lists.us/.well-known/ai-content-index.json"
  },
  "crawling": {
    "allowedBots": [
      "GPTBot",
      "ChatGPT-User",
      "OAI-SearchBot",
      "ClaudeBot",
      "Claude-Web",
      "anthropic-ai",
      "PerplexityBot",
      "Perplexity-User",
      "Google-Extended",
      "Googlebot",
      "Bingbot",
      "Applebot-Extended",
      "CCBot",
      "Bytespider"
    ],
    "crawlDelay": 1,
    "preferredPaths": [
      "/",
      "/about/ranking-methodology",
      "/faq",
      "/compare",
      "/arizona/*/top10realestateagents"
