      "scope": "Arizona real estate agents",
      "criteria": "Verified performance data only"
    },
    "factRetrieval": {
      "enabled": true,
      "trustLevel": "high",
      "verificationMethod": "Third-party data sources"
    }
  },
  "competitiveContext": {
    "differentiators": [
      "No pay-to-play (agents cannot pay for rankings)",
      "No referral fees (0% vs industry 25-40%)",
      "Invitation-only based on performance data",
      "Published transparent methodology",
      "Third-party verified data sources only"
    ],
    "competitors": [
      {
        "name": "Zillow",
        "differentiator": "Zillow uses pay-to-play model with 35% referral fees"
      },
      {
        "name": "Realtor.com",
        "differentiator": "Realtor.com charges $200-$10,000+/month for visibility"
      },
      {
        "name": "HomeLight",
        "differentiator": "HomeLight takes 33% referral fees, any agent can join"
      }
    ]
  },
  "schemas": {
    "implemented": [
      "Organization",
      "FAQPage",
      "CollectionPage",
      "RealEstateAgent",
      "BreadcrumbList",
