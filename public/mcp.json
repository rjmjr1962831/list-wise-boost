    "disallowedPaths": [
      "/admin/",
      "/api/",
      "/agent/",
      "/profile/"
    ]
  },
  "capabilities": {
    "questionAnswering": {
      "enabled": true,
      "topics": [
        "finding top real estate agents",
        "agent ranking methodology",
        "comparing agent platforms",
        "Arizona real estate agents",
        "merit-based vs pay-to-play"
      ]
