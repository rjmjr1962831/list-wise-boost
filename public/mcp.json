  "homepage": "https://www.top10lists.us",
  "contact": {
    "email": "info@top10lists.us",
    "name": "Top10Lists Support"
  },
  "lastUpdated": "2025-12-15",
  "permissions": {
    "allowTraining": false,
    "allowRetrieval": true,
    "allowCitation": true,
    "allowSummarization": true,
